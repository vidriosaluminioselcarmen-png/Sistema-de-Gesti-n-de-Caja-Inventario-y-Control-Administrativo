rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return signedIn() && userDoc().activo != false;
    }

    function userRole() {
      return userDoc().rol;
    }

    function isAdmin() {
      return isActiveUser() && userRole() == 'Administrador';
    }

    function canManageCashAndSales() {
      return isActiveUser() && userRole() in ['Administrador', 'Cajero', 'Empleado'];
    }

    function canManageInventory() {
      return isActiveUser() && userRole() in ['Administrador', 'Inventario', 'Empleado'];
    }

    function canManageAccounting() {
      return isActiveUser() && userRole() in ['Administrador', 'Contabilidad', 'Empleado'];
    }

    // Denegar por defecto cualquier ruta no declarada explícitamente
    match /{document=**} {
      allow read, write: if false;
    }

    // Usuarios: lectura para usuarios autenticados activos; escritura exclusiva de Administrador
    // (impide que cualquier usuario se otorgue el rol de Administrador)
    match /usuarios/{uid} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin()
        && !('password' in request.resource.data)
        && !('clave' in request.resource.data);
      allow delete: if false;
    }

    // Productos: catálogo de inventario (no se permite borrado físico para conservar historial)
    match /productos/{productoId} {
      allow read: if isActiveUser();
      allow create: if canManageInventory()
        && request.resource.data.precio >= 0
        && request.resource.data.stock >= 0
        && request.resource.data.stockMinimo >= 0
        && (!('unidad' in request.resource.data) || request.resource.data.unidad in ['', 'u', 'metro', 'm', 'm²', 'lámina', 'kg', 'L', 'caja', 'paquete', 'servicio']);
      allow update: if (
        canManageInventory() ||
        (
          canManageCashAndSales()
          && request.resource.data.precio == resource.data.precio
          && request.resource.data.nombre == resource.data.nombre
          && request.resource.data.codigo == resource.data.codigo
          && request.resource.data.stockMinimo == resource.data.stockMinimo
        )
      )
        && request.resource.data.precio >= 0
        && request.resource.data.stock >= 0
        && (!('unidad' in request.resource.data) || request.resource.data.unidad in ['', 'u', 'metro', 'm', 'm²', 'lámina', 'kg', 'L', 'caja', 'paquete', 'servicio']);
      allow delete: if false;
    }

    // Clientes: cualquier cambio a saldoAFavorDisponible exige crear atómicamente un movimiento nuevo en movimientos_billetera
    match /clientes/{clienteId} {
      allow read: if isActiveUser();
      allow create: if canManageCashAndSales()
        && (!('saldoAFavorDisponible' in request.resource.data) || request.resource.data.saldoAFavorDisponible == 0);
      allow update: if canManageCashAndSales()
        && (
          !('saldoAFavorDisponible' in request.resource.data)
          || request.resource.data.saldoAFavorDisponible == (
            'saldoAFavorDisponible' in resource.data ? resource.data.saldoAFavorDisponible : 0
          )
          || (
            request.resource.data.saldoAFavorDisponible >= 0
            && request.resource.data.ultimoMovimientoBilleteraId is string
            && request.resource.data.ultimoMovimientoBilleteraId != (
              'ultimoMovimientoBilleteraId' in resource.data ? resource.data.ultimoMovimientoBilleteraId : ''
            )
            && (
              isAdmin()
              || request.resource.data.saldoAFavorDisponible < (
                'saldoAFavorDisponible' in resource.data ? resource.data.saldoAFavorDisponible : 0
              )
            )
            && getAfter(/databases/$(database)/documents/movimientos_billetera/$(request.resource.data.ultimoMovimientoBilleteraId)).data.clienteId == clienteId
            && getAfter(/databases/$(database)/documents/movimientos_billetera/$(request.resource.data.ultimoMovimientoBilleteraId)).data.saldoAnterior == (
              'saldoAFavorDisponible' in resource.data ? resource.data.saldoAFavorDisponible : 0
            )
            && getAfter(/databases/$(database)/documents/movimientos_billetera/$(request.resource.data.ultimoMovimientoBilleteraId)).data.saldoPosterior == request.resource.data.saldoAFavorDisponible
          )
        );
      allow delete: if false;
    }

    // Cajas: una caja cerrada jamás puede reabrirse ni alterarse su base/apertura
    match /cajas/{cajaId} {
      allow read: if isActiveUser();
      allow create: if canManageCashAndSales()
        && request.resource.data.estado == 'Abierta'
        && request.resource.data.montoInicial >= 0;
      allow update: if canManageCashAndSales()
        && resource.data.estado == 'Abierta'
        && request.resource.data.montoInicial == resource.data.montoInicial
        && request.resource.data.fechaApertura == resource.data.fechaApertura
        && request.resource.data.usuarioApertura == resource.data.usuarioApertura;
      allow delete: if false;
    }

    // Ventas: inmutables en sus totales; solo un Administrador puede pasar su estado a Anulada o Devuelta,
    // y el personal autorizado de Caja/Ventas puede registrar abonos reduciendo saldoPendiente e incrementando pagos en 1.
    match /ventas/{ventaId} {
      allow read: if isActiveUser();
      allow create: if canManageCashAndSales()
        && request.resource.data.estado == 'Completada'
        && request.resource.data.total > 0
        && request.resource.data.items.size() > 0;
      allow update: if (
        isAdmin()
        && resource.data.estado == 'Completada'
        && request.resource.data.estado in ['Anulada', 'Devuelta']
        && request.resource.data.total == resource.data.total
        && request.resource.data.items == resource.data.items
        && request.resource.data.cliente == resource.data.cliente
        && request.resource.data.numero == resource.data.numero
        && request.resource.data.pagos == resource.data.pagos
      ) || (
        isAdmin()
        && resource.data.estado == 'Completada'
        && request.resource.data.estado in ['Completada', 'Devuelta']
        && request.resource.data.total == resource.data.total
        && request.resource.data.items == resource.data.items
        && request.resource.data.cliente == resource.data.cliente
        && request.resource.data.numero == resource.data.numero
        && request.resource.data.pagos == resource.data.pagos
        && request.resource.data.saldoPendiente >= 0
        && request.resource.data.saldoPendiente <= resource.data.saldoPendiente
        && request.resource.data.totalDevueltoAcumulado >= 0
      ) || (
        canManageCashAndSales()
        && resource.data.estado == 'Completada'
        && request.resource.data.estado == 'Completada'
        && request.resource.data.total == resource.data.total
        && request.resource.data.items == resource.data.items
        && request.resource.data.cliente == resource.data.cliente
        && request.resource.data.numero == resource.data.numero
        && request.resource.data.saldoPendiente >= 0
        && request.resource.data.saldoPendiente < resource.data.saldoPendiente
        && request.resource.data.importePagado > resource.data.importePagado
        && request.resource.data.pagos.size() == resource.data.pagos.size() + 1
      );
      allow delete: if false;
    }

    // Movimientos de inventario (Kardex histórico inmutable)
    match /movimientos_inventario/{movId} {
      allow read: if isActiveUser();
      allow create: if canManageInventory() || canManageCashAndSales();
      allow update, delete: if false;
    }

    // Movimientos contables (Ingresos, Gastos y Traslados internos; nunca se eliminan físicamente)
    match /movimientos_contables/{movId} {
      allow read: if isActiveUser();
      allow create: if (canManageAccounting() || canManageCashAndSales())
        && (request.resource.data.monto > 0 || request.resource.data.valor > 0);
      allow update: if (
        isAdmin()
        && request.resource.data.monto == resource.data.monto
      ) || (
        (canManageAccounting() || canManageCashAndSales())
        && request.resource.data.monto == resource.data.monto
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.categoria == resource.data.categoria
        && request.resource.data.metodoPago == resource.data.metodoPago
        && (!('aplicadoEnVentaId' in resource.data) || resource.data.aplicadoEnVentaId == null)
        && request.resource.data.aplicadoEnVentaId is string
      );
      allow delete: if false;
    }

    // Devoluciones (requiere rol Administrador)
    match /devoluciones/{devId} {
      allow read: if isActiveUser();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Auditoría del sistema (solo lectura para Administrador, inserción en operaciones trazables)
    match /auditoria/{audId} {
      allow read: if isAdmin();
      allow create: if isActiveUser();
      allow update, delete: if false;
    }

    // Control transaccional de consecutivos (incremento estrictamente monotónico +1, sin retroceso ni borrado)
    match /control/consecutivo_ventas {
      allow read: if isActiveUser();
      allow create: if canManageCashAndSales()
        && request.resource.data.ultimoNumero is int
        && request.resource.data.ultimoNumero >= 1;
      allow update: if canManageCashAndSales()
        && request.resource.data.ultimoNumero is int
        && request.resource.data.ultimoNumero == resource.data.ultimoNumero + 1;
      allow delete: if false;
    }

    // Control transaccional de caja activa única
    match /control/caja_activa {
      allow read: if isActiveUser();
      allow create: if canManageCashAndSales()
        && request.resource.data.activa == true;
      allow update: if canManageCashAndSales()
        && (resource.data.activa != request.resource.data.activa || isAdmin());
      allow delete: if false;
    }

    // Registro persistente de idempotencia de operaciones (inmutable: crear una sola vez, jamás sobrescribir o borrar)
    match /operaciones/{opId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && !exists(/databases/$(database)/documents/operaciones/$(opId));
      allow update, delete: if false;
    }

    // Movimientos inmutables de billetera de saldos a favor por cliente (validados atómicamente con getAfter)
    match /movimientos_billetera/{movId} {
      allow read: if isActiveUser();
      allow create: if canManageCashAndSales()
        && request.resource.data.clienteId is string
        && request.resource.data.monto > 0
        && request.resource.data.saldoAnterior >= 0
        && request.resource.data.saldoPosterior >= 0
        && request.resource.data.tipo in ['GENERACION', 'REDENCION', 'AJUSTE_COMPENSATORIO']
        && (
          request.resource.data.tipo != 'GENERACION'
          || (
            isAdmin()
            && request.resource.data.devolucionId is string
            && request.resource.data.saldoPosterior == request.resource.data.saldoAnterior + request.resource.data.monto
            && getAfter(/databases/$(database)/documents/devoluciones/$(request.resource.data.devolucionId)).data.cliente.id == request.resource.data.clienteId
            && getAfter(/databases/$(database)/documents/devoluciones/$(request.resource.data.devolucionId)).data.saldoAFavorGenerado == request.resource.data.monto
          )
        )
        && (
          request.resource.data.tipo != 'AJUSTE_COMPENSATORIO'
          || (
            isAdmin()
            && request.resource.data.ventaId is string
            && request.resource.data.saldoPosterior == request.resource.data.saldoAnterior + request.resource.data.monto
            && getAfter(/databases/$(database)/documents/ventas/$(request.resource.data.ventaId)).data.estado == 'Anulada'
            && getAfter(/databases/$(database)/documents/ventas/$(request.resource.data.ventaId)).data.cliente.id == request.resource.data.clienteId
            && getAfter(/databases/$(database)/documents/ventas/$(request.resource.data.ventaId)).data.saldoAFavorAplicado == request.resource.data.monto
          )
        )
        && (
          request.resource.data.tipo != 'REDENCION'
          || (
            request.resource.data.ventaId is string
            && request.resource.data.saldoPosterior == request.resource.data.saldoAnterior - request.resource.data.monto
            && getAfter(/databases/$(database)/documents/ventas/$(request.resource.data.ventaId)).data.cliente.id == request.resource.data.clienteId
            && getAfter(/databases/$(database)/documents/ventas/$(request.resource.data.ventaId)).data.saldoAFavorAplicado == request.resource.data.monto
          )
        );
      allow update, delete: if false;
    }
  }
}
